{
  "name": "@cet/content",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Roberto Mendizabal",
  "description": "Pipeline de extraccion Y6A HTML -> content packs JSON validados",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./sanitize": "./src/sanitize.ts",
    "./pdf": "./src/corpus/pdf.ts"
  },
  "scripts": {
    "extract": "tsx src/cli.ts",
    "extract:check": "tsx src/cli.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src __tests__"
  },
  "dependencies": {
    "@cet/shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cet/engine": "workspace:^",
    "@types/node": "^22.10.0",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
