#
# Copia este fichero a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore. NUNCA se commitea un valor real aquí.
# ---------------------------------------------------------------------------

# --- Supabase: público (llega al navegador, es correcto que sea visible) -----
# El proyecto de producción es `clcutoqjdgeggvgyreud`.
# La clave anon NO es un secreto: su poder está acotado por RLS. Si un dato se
# filtra con la clave anon, el bug está en la política RLS, no en la clave.
NEXT_PUBLIC_SUPABASE_URL=https://clcutoqjdgeggvgyreud.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PON_AQUI_TU_ANON_KEY.xxxxxxxxxxxx

# --- Supabase: SECRETO. Solo servidor. --------------------------------------
# ATENCIÓN: esta clave SALTA RLS por completo. No lleva el prefijo NEXT_PUBLIC_
# precisamente para que Next.js se niegue a incluirla en un bundle de navegador.
# Solo se lee desde `src/lib/supabase/admin.ts`, que además aborta si detecta
# que se está ejecutando en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PON_AQUI_TU_SERVICE_ROLE_KEY.xxxxxxxxxxxx

# --- Aplicación --------------------------------------------------------------
# URL canónica. Se usa en metadatos, en enlaces absolutos y en los formularios
# de autenticación. En preview de Vercel, apúntala a la URL del preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para hashear IPs antes de guardarlas (DATA_MODEL §6: nunca la IP en claro).
# Genera una con: openssl rand -hex 32
CET_IP_HASH_SALT=cambia_esto_por_32_bytes_aleatorios_en_hex

# --- Desarrollo --------------------------------------------------------------
# Ponlo a `1` solo en local si necesitas ver la traza completa de un error de
# autenticación. En producción los mensajes de error son deliberadamente vagos.
CET_VERBOSE_AUTH_ERRORS=0
