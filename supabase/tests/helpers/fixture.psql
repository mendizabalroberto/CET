-- =============================================================================
-- helpers/fixture.psql — mundo de pruebas compartido por los tests pgTAP
-- Cambridge Exam Trainer · © 2026 Roberto Mendizabal.
-- =============================================================================
-- NO es un fichero de test. Vive en `helpers/` y con extensión `.psql` para que
-- el glob de pg_prove (`supabase/tests/*.sql`) no lo recoja como test suelto: un
-- fichero sin `plan()` se contaría como fallo.
--
-- Se incluye con `\ir helpers/fixture.psql`, que es relativo AL FICHERO que lo
-- incluye, no al directorio de trabajo. Así los tests corren igual desde la raíz
-- del repo, desde supabase/ o desde CI.
--
-- Todo lo que crea vive dentro de la transacción del test y desaparece con el
-- ROLLBACK final. Ninguna prueba deja rastro.
--
-- EL MUNDO:
--   Colegio A "alfa"  — admin_a, teacher_a, alumnos s1a y s2a
--   Colegio B "beta"  — admin_b, teacher_b, alumno  s1b
--   superadmin sin colegio
--   Curso Math Y6 GLOBAL + una skill + una pregunta con dos versiones
--   Un blueprint y una asignación por colegio, con un intento completo por
--   alumno (items, respuestas con revisiones y calificación).
-- =============================================================================

-- -----------------------------------------------------------------------------
-- Suplantación de identidad
-- -----------------------------------------------------------------------------
-- Reproduce exactamente lo que hace PostgREST al recibir un JWT: fija el GUC
-- `request.jwt.claims` y cambia al rol `authenticated`. A partir de ahí,
-- auth.uid() devuelve el sub y TODAS las políticas RLS se aplican de verdad.
-- Un test de RLS que corre como `postgres` no prueba nada: el propietario de la
-- tabla se salta las políticas.
create or replace function pg_temp.login_as(p_profile uuid)
returns void language plpgsql as $fn$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_profile::text, 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end $fn$;

-- Vuelve al rol de la sesión (postgres) para poder seguir sembrando.
create or replace function pg_temp.logout()
returns void language plpgsql as $fn$
begin
  perform set_config('request.jwt.claims', '', true);
  reset role;
end $fn$;

-- Cuenta filas visibles capturando el "permission denied for table/column" como
-- 0 filas. Sin esto, un test que comprueba aislamiento revienta con un error de
-- privilegios en vez de reportar el número de filas visibles — y un error no es
-- un resultado, es un test que no ha llegado a ejecutarse.
create or replace function pg_temp.visible_count(p_sql text)
returns integer language plpgsql as $fn$
declare n integer;
begin
  execute p_sql into n;
  return n;
exception
  when insufficient_privilege then return 0;
  when undefined_table        then return 0;
end $fn$;

-- Nº de filas que una escritura consigue tocar. Devuelve -1 si el rol ni
-- siquiera tiene el GRANT. La distinción importa: "0 filas afectadas" significa
-- que la RLS filtró la fila; "-1" que el privilegio no existe. Ambas son
-- defensas válidas, pero son defensas DISTINTAS y conviene saber cuál actuó.
create or replace function pg_temp.affected(p_sql text)
returns integer language plpgsql as $fn$
declare n integer;
begin
  execute p_sql;
  get diagnostics n = row_count;
  return n;
exception when insufficient_privilege then
  return -1;
end $fn$;

-- ¿Falla esta sentencia? Devuelve el SQLSTATE, o NULL si tuvo éxito.
create or replace function pg_temp.errcode_of(p_sql text)
returns text language plpgsql as $fn$
begin
  execute p_sql;
  return null;
exception when others then
  return sqlstate;
end $fn$;


